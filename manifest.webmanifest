{
  "name": "Shift Calendar",
  "short_name": "Shifts",
  "description": "Private shift and appointment calendar",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f5fa",
  "theme_color": "#7c3aed",
  "icons": [
